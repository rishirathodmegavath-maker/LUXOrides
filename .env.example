# Copy to .env and fill in for LOCAL DEVELOPMENT ONLY.
#
# EXPO_PUBLIC_API_BASE_URL: the Fleetovo backend's LAN IP (not localhost,
# since Expo Go / a dev client runs on a physical device, not this machine)
# -- replace with whatever machine on your network is running the backend.
# EXPO_PUBLIC_ORG_ID: the org id your local backend seeds for driver login.
#
# Production builds must NOT use this file or these values -- see
# src/config/env.ts (rejects localhost/private-LAN/"demo" outside dev) and
# eas.json (production profile reads EXPO_PUBLIC_API_BASE_URL/EXPO_PUBLIC_ORG_ID
# from EAS's own Environment Variables for the "production" environment,
# configured externally via `eas env:create`, never from this file).
EXPO_PUBLIC_API_BASE_URL=http://<YOUR_BACKEND_LAN_IP>:8443
EXPO_PUBLIC_ORG_ID=<YOUR_DEV_ORG_ID>

# Optional. Store links shown on the force-update gate (src/screens/UpdateRequiredScreen.tsx,
# see the backend's app.chauffeur.min-supported-version). Leave blank until
# this app has a real published listing on each store -- "Update Now" simply
# doesn't render rather than linking to a fabricated/placeholder page.
EXPO_PUBLIC_ANDROID_STORE_URL=
EXPO_PUBLIC_IOS_STORE_URL=
